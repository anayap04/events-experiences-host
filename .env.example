# Hostinger phpMyAdmin MySQL Database Credentials Template
MYSQL_HOST=your_database_host
MYSQL_PORT=3306
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password
MYSQL_DATABASE=your_database_name

# Static deployment and browser-facing runtime configuration
NEXT_PUBLIC_BASE_PATH=/events-experiences
NEXT_PUBLIC_SITE_URL=https://anayap.tech/events-experiences/
NEXT_PUBLIC_MFE_EVENTS_URL=https://events.anayap.tech/remoteEntry.js
NEXT_PUBLIC_MFE_EXPERIENCES_URL=https://experiences.anayap.tech/remoteEntry.js
NEXT_PUBLIC_MFE_TICKETS_URL=https://tickets.anayap.tech/remoteEntry.js

# Hostinger FTP deployment constants
# Keep credentials in GitHub Actions secrets, not in this file.
HOSTINGER_HOST=your_hostinger_ftp_host
HOSTINGER_USERNAME=your_hostinger_ftp_username
HOSTINGER_PORT=21
HOSTINGER_SERVER_DIR=./domains/anayap.tech/public_html/events-experiences/
